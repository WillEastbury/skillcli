{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WillEastbury/skillcli/schemas/catalogue.schema.json",
  "title": "skillcli catalogue metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "library",
    "taxonomy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "repository",
        "namespace",
        "defaultRef",
        "updatePolicy",
        "governance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "defaultRef": {
          "type": "string",
          "minLength": 1
        },
        "browserPlugin": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "readmePlugins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "updatePolicy": {
          "const": "notify-only"
        },
        "governance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "taskCategories",
        "maxResults"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedId"
          }
        },
        "taskCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedId"
          }
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  },
  "$defs": {
    "namedId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WillEastbury/skillcli/schemas/skills.schema.json",
  "title": "Digital Native Skills Library registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifestVersion",
    "library",
    "taxonomy",
    "skills"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/skills.schema.json"
    },
    "manifestVersion": {
      "$ref": "#/$defs/version"
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "repository",
        "namespace",
        "defaultRef",
        "updatePolicy",
        "governance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "defaultRef": {
          "$ref": "#/$defs/text"
        },
        "browserSkillId": {
          "$ref": "#/$defs/id"
        },
        "updatePolicy": {
          "const": "notify-only"
        },
        "governance": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "taskCategories",
        "maxResults"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namedId"
          }
        },
        "taskCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namedId"
          }
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "namedId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "status",
        "path",
        "entrypoint",
        "roles",
        "taskCategories",
        "keywords",
        "runtime",
        "capabilities",
        "source",
        "review",
        "files"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "discovered",
            "review",
            "approved",
            "deprecated",
            "blocked"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "entrypoint": {
          "const": "SKILL.md"
        },
        "roles": {
          "$ref": "#/$defs/idList"
        },
        "taskCategories": {
          "$ref": "#/$defs/idList"
        },
        "keywords": {
          "$ref": "#/$defs/idList"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "dependencies"
          ],
          "properties": {
            "language": {
              "enum": [
                "none",
                "python",
                "javascript",
                "typescript",
                "powershell",
                "other"
              ]
            },
            "dependencies": {
              "$ref": "#/$defs/textList"
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "filesystem",
            "shell",
            "mcpServers",
            "authentication"
          ],
          "properties": {
            "network": {
              "$ref": "#/$defs/textList"
            },
            "filesystem": {
              "enum": [
                "none",
                "read-only",
                "read-write"
              ]
            },
            "shell": {
              "$ref": "#/$defs/textList"
            },
            "mcpServers": {
              "$ref": "#/$defs/textList"
            },
            "authentication": {
              "$ref": "#/$defs/textList"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "repository",
            "license"
          ],
          "properties": {
            "type": {
              "enum": [
                "internal",
                "third-party"
              ]
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reviewedBy",
            "reviewedAt"
          ],
          "properties": {
            "state": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "reviewedBy": {
              "$ref": "#/$defs/textList"
            },
            "reviewedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[^\\\\/]+(?:/[^\\\\/]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
